OPENAI_API_KEY=
DATABASE_URL=postgresql://rag:ragsecret@localhost:5434/ragdb

# true enables offline demo providers and a separate assistant_demo database schema.
# Restart the server after changing this setting. No API key is needed in demo mode.
DEMO_MODE=false

# Optional tuning (defaults from the project reference)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ANSWER_MODEL=gpt-4o-mini
HELPER_MODEL=gpt-4o-mini
CHUNK_SIZE=600
CHUNK_OVERLAP=120
CANDIDATES=12
TOP_K=4
MIN_RERANK_SCORE=4
HIGH_CONFIDENCE_SCORE=8
RRF_CONSTANT=60
MAX_ATTEMPTS=2
STALE_AFTER_DAYS=180
